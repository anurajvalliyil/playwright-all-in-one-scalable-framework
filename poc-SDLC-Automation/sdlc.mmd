graph TD
    Orchestrator["Orchestrator (orchestrate.ts)"]
    RA["Requirements Analyst"]
    TP["Test Planner"]
    TD["Test Data Generator"]
    EP["Execution Pool (Concurrent Slots)"]
    UI["UI Executor"]
    API["API Executor"]
    Playwright["Playwright Sandbox"]
    CV["Cross Validator"]
    RCA["Root Cause Analyst"]
